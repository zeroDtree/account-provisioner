# Account provisioner environment file
# Copy to .env and edit.

# Upstream API base URL
UPSTREAM_API_URL=http://localhost:8080

# Agent pre-shared key (required; must match server configuration)
AGENT_PSK=replace-with-agent-psk

# Required. Server id (sent as JSON serverId on internal API calls)
AGENT_SERVER_ID=gpu-node-01

# Poll interval (seconds, minimum 5)
PROVISION_POLL_INTERVAL=30

# Path to isolation repo checkout (default: ./isolation submodule)
# ISOLATION_DIR=./isolation

# Absolute data root passed to add-user.sh / remove-user.sh
DATA_ROOT=/data

# Script that prints the SSH-reachable IPv4 on stdout (default: hooks/ipv4.sh)
# PROVISION_IPV4_CALLBACK=/path/to/my-ipv4.sh

# Use sudo -n when not running as root (1 = yes, 0 = no)
PROVISION_USE_SUDO=1

# Dry run: log actions only, do not exec scripts or call complete (1 = yes)
# PROVISION_DRY_RUN=0

# Localhost health endpoint (0 = disabled)
AGENT_HEALTH_HOST=127.0.0.1
AGENT_HEALTH_PORT=9091
